function Init() as void
    m.poster = m.top.findNode("thumbnail")
    m.title = m.top.findNode("title")
    m.channel = m.top.findNode("channel")
    m.border = m.top.findNode("border")
end function

function OnContent() as void
    item = m.top.itemContent
    if item = invalid
        return
    end if
    m.poster.uri = item.hdPosterUrl
    m.title.text = item.title
    m.channel.text = item.secondaryTitle
end function

function OnFocus() as void
    if m.top.focusPercent > 0.5
        m.border.color = "#FF6600FF"
    else
        m.border.color = "#333333FF"
    end if
end function
