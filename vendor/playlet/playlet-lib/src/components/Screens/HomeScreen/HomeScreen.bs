import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/Types.bs"

function Init() as void
    m.top.focusable = true
    m.grid = m.top.findNode("grid")
    m.toolbar = m.top.findNode("toolbar")
    m.items = []
    m.selected = 0
    m.firstRow = 0
    m.loading = false
    m.advanceAfterLoad = false
    m.appending = false
    m.status = m.top.findNode("status")
    m.empty = m.top.findNode("empty")
    m.picker = m.top.findNode("picker")
    m.task = m.top.findNode("catalogTask")
    m.taxonomy = StringUtils.ParseJsonSafe(ReadAsciiFile("libpkg:/config/hackertube-taxonomy.json"))
    m.dataInfo = StringUtils.ParseJsonSafe(ReadAsciiFile("libpkg:/config/hackertube-data-info.json"))
    m.query = ""
    m.area = ""
    m.category = ""
    m.topicName = "All topics"
    m.sort = "recommended"
    m.page = 0
    m.pages = 1
    m.serial = 0
    m.pending = invalid
    m.toolIndex = 0
    m.focusArea = "toolbar"
    m.pickerMode = ""
    m.loaded = false
    labels = ["Search", "Topics", "Sort", "About"]
    for i = 0 to labels.Count() - 1
        m.top.findNode("tool" + i.ToStr()).text = labels[i]
    end for
    m.task.observeField("result", FuncName(OnCatalogResult))
    m.task.observeField("state", FuncName(OnTaskState))
end function

function OnNodeReady() as void
    RequestPage()
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    if m.pickerMode <> ""
        NodeSetFocus(m.picker, true)
    else if m.focusArea = "grid" and m.loaded
        NodeSetFocus(m.grid, true)
    else
        FocusToolbar()
    end if
end function

function FocusToolbar() as void
    m.focusArea = "toolbar"
    m.advanceAfterLoad = false
    m.top.findNode("toolFocus").visible = true
    m.top.findNode("toolFocus").translation = [m.toolIndex * 192, 0]
    ' bs:disable-next-line NO_SET_FOCUS
    m.toolbar.SetFocus(true)
    RenderGrid()
end function

function FocusGrid() as void
    if not m.loaded
        FocusToolbar()
        return
    end if
    m.focusArea = "grid"
    m.top.findNode("toolFocus").visible = false
    NodeSetFocus(m.grid, true)
    RenderGrid()
end function

function RequestPage() as void
    m.appending = false
    m.loading = true
    m.advanceAfterLoad = false
    m.items = []
    m.selected = 0
    m.firstRow = 0
    m.serial += 1
    m.pending = { serial: m.serial, query: m.query, area: m.area, category: m.category, sort: m.sort, page: m.page }
    m.loaded = false
    m.grid.visible = false
    m.empty.visible = false
    m.status.text = "Loading videos..."
    StartPendingRequest()
end function

function StartPendingRequest() as void
    if m.pending = invalid or m.task.state = "run"
        return
    end if
    m.task.request = m.pending
    m.pending = invalid
    m.task.control = "run"
end function

function OnTaskState() as void
    if m.task.state <> "run"
        StartPendingRequest()
    end if
end function

function OnCatalogResult() as void
    result = m.task.result
    if result = invalid or result.serial <> m.serial
        return
    end if
    if result.error <> invalid
        m.loading = false
        m.advanceAfterLoad = false
        if m.appending
            m.status.text = "Could not load more videos. Press Down to retry."
            return
        end if
        m.empty.text = result.error
        m.empty.visible = true
        m.grid.visible = false
        m.loaded = false
        m.status.text = "Catalog unavailable"
        FocusToolbar()
        return
    end if
    m.loading = false
    m.page = result.page
    m.pages = result.pages
    m.total = result.total
    for each item in result.items
        m.items.Push(item)
    end for
    m.loaded = m.items.Count() > 0
    m.grid.visible = m.loaded and m.pickerMode = ""
    m.empty.visible = not m.loaded and m.pickerMode = ""
    m.empty.text = "No videos match. Try another search or topic."
    m.top.findNode("count").text = result.total.ToStr() + " videos  |  Back: menu"
    if m.advanceAfterLoad and m.focusArea = "grid" and m.pickerMode = ""
        m.selected = MinIndex(m.selected + 4, m.items.Count() - 1)
    end if
    m.advanceAfterLoad = false
    UpdateStatus()
    RenderGrid()

end function

function UpdateStatus() as void
    sortName = "Top recommended"
    if m.sort = "recent"
        sortName = "Recently recommended on HN"
    else if m.sort = "az"
        sortName = "Title A-Z"
    end if
    title = m.topicName + "  /  " + sortName
    if m.query <> ""
        title += "  /  Search: " + m.query
    end if
    m.status.text = title
end function

function OnVideoSelected() as void
    if not m.loaded or not m.grid.hasFocus() or m.focusArea <> "grid" or m.pickerMode <> ""
        return
    end if
    item = m.items[m.selected]
    if item = invalid
        return
    end if
    m.advanceAfterLoad = false
    node = VideoNode(item)
    m.videoQueue.clearQueue = true
    m.videoQueue.playVideo = node
end function

function VideoNode(item as object) as object
    node = CreateObject("roSGNode", "VideoContentNode")
    node.videoId = item.id
    node.title = item.title
    node.secondaryTitle = item.channel
    node._author = item.channel
    node.hdPosterUrl = "https://i.ytimg.com/vi/" + item.id + "/mqdefault.jpg"
    return node
end function

function MinIndex(a as integer, b as integer) as integer
    if a < b
        return a
    end if
    return b
end function

function RenderGrid() as void
    row = Int(m.selected / 4)
    if row < m.firstRow
        m.firstRow = row
    else if row > m.firstRow + 1
        m.firstRow = row - 1
    end if
    for i = 0 to 7
        card = m.top.findNode("card" + i.ToStr())
        idx = m.firstRow * 4 + i
        card.visible = idx < m.items.Count()
        if card.visible
            if card.itemContent = invalid or card.itemContent.videoId <> m.items[idx].id
                card.itemContent = VideoNode(m.items[idx])
            end if
            if idx = m.selected and m.focusArea = "grid"
                card.focusPercent = 1.0
            else
                card.focusPercent = 0.0
            end if
        end if
    end for
end function

function LoadMore(advance as boolean) as void
    if m.page + 1 >= m.pages
        return
    end if
    if advance
        m.advanceAfterLoad = true
    end if
    if m.loading
        return
    end if
    m.loading = true
    m.appending = true
    m.serial += 1
    m.pending = { serial: m.serial, query: m.query, area: m.area, category: m.category, sort: m.sort, page: m.page + 1 }
    m.status.text = "Loading more videos..."
    StartPendingRequest()
end function

function MoveGrid(key as string) as void
    count = m.items.Count()
    if count = 0
        return
    end if
    m.advanceAfterLoad = false
    if key = "up"
        if m.selected < 4
            FocusToolbar()
            return
        end if
        m.selected -= 4
    else if key = "down"
        if m.selected + 4 < count
            m.selected += 4
        else if Int(m.selected / 4) < Int((count - 1) / 4)
            m.selected = count - 1
        else
            LoadMore(true)
        end if
    else if key = "left"
        if m.selected mod 4 > 0
            m.selected -= 1
        end if
    else if key = "right"
        if m.selected mod 4 < 3 and m.selected + 1 < count
            m.selected += 1
        end if
    end if
    RenderGrid()
    if m.selected >= count - 8
        LoadMore(false)
    end if
end function

function OpenSearch() as void
    dialog = CreateObject("roSGNode", "KeyboardDialog")
    dialog.title = "Search HackerTube"
    dialog.text = m.query
    dialog.buttons = ["Search", "Clear search", "Cancel"]
    dialog.observeField("buttonSelected", FuncName(OnSearchSelected))
    dialog.observeField("wasClosed", FuncName(OnDialogClosed))
    m.searchDialog = dialog
    m.top.getScene().dialog = dialog
end function

function OnSearchSelected() as void
    index = m.searchDialog.buttonSelected
    if index = 0
        m.query = m.searchDialog.text.Trim()
    else if index = 1
        m.query = ""
    end if
    m.searchDialog.close = true
    if index < 2
        m.page = 0
        RequestPage()
    end if
end function

function OnDialogClosed() as void
    FocusToolbar()
end function

function ShowPicker(mode as string, entries as object, title as string) as void
    m.advanceAfterLoad = false
    m.pickerMode = mode
    m.pickerEntries = entries
    m.pickerIndex = 0
    m.pickerFirst = 0
    for i = 0 to entries.Count() - 1
        entry = entries[i]
        if (mode = "sort" and entry.id = m.sort) or (mode = "topics" and entry.area = m.area and entry.category = m.category)
            m.pickerIndex = i
        end if
    end for
    RenderPicker()
    m.grid.visible = false
    m.empty.visible = false
    m.picker.visible = true
    m.top.findNode("pickerBackground").visible = true
    m.top.findNode("toolFocus").visible = false
    m.status.text = title + "  /  Back to cancel"
    NodeSetFocus(m.picker, true)
end function

function RenderPicker() as void
    if m.pickerIndex < m.pickerFirst
        m.pickerFirst = m.pickerIndex
    else if m.pickerIndex >= m.pickerFirst + 10
        m.pickerFirst = m.pickerIndex - 9
    end if
    for i = 0 to 9
        label = m.top.findNode("pickerLabel" + i.ToStr())
        index = m.pickerFirst + i
        label.visible = index < m.pickerEntries.Count()
        if label.visible
            label.text = m.pickerEntries[index].name
        end if
    end for
    m.top.findNode("pickerFocus").translation = [0, (m.pickerIndex - m.pickerFirst) * 48]
end function

function OpenTopics() as void
    entries = [{ area: "", category: "", name: "All topics" }]
    for each area in m.taxonomy.areas
        entries.Push({ area: area.id, category: "", name: area.name })
        for each category in area.categories
            entries.Push({ area: area.id, category: category.id, name: "    " + category.name })
        end for
    end for
    ShowPicker("topics", entries, "Choose a topic")
end function

function ClosePicker() as void
    m.pickerMode = ""
    m.picker.visible = false
    m.top.findNode("pickerBackground").visible = false
    m.grid.visible = m.loaded
    m.empty.visible = not m.loaded
    UpdateStatus()
    FocusToolbar()
end function

function OnPickerSelected() as void
    if m.pickerMode = ""
        return
    end if
    choice = m.pickerEntries[m.pickerIndex]
    if choice = invalid
        return
    end if
    if m.pickerMode = "sort"
        m.sort = choice.id
    else
        m.area = choice.area
        m.category = choice.category
        m.topicName = choice.name.Trim()
    end if
    m.page = 0
    ClosePicker()
    RequestPage()
end function

function ActivateTool() as void
    if m.toolIndex = 0
        OpenSearch()
    else if m.toolIndex = 1
        OpenTopics()
    else if m.toolIndex = 2
        ShowPicker("sort", [{ id: "recommended", name: "Top recommended" }, { id: "recent", name: "Recently recommended on HN" }, { id: "az", name: "Title A-Z" }], "Sort videos")
    else
        dialog = CreateObject("roSGNode", "Dialog")
        dialog.title = "About HackerTube"
        dialog.message = "Videos curated by HackerTube, created by Andrej Karpathy." + Chr(10) + Chr(10)
        dialog.message += "Roku app built by Piyush Khemka." + Chr(10) + Chr(10)
        dialog.message += "Source code" + Chr(10) + "github.com/piyushkhemka/hackertube-roku-app" + Chr(10) + Chr(10)
        dialog.message += "Playback powered by Playlet, created by iBicha and contributors. Licensed under GNU AGPL-3.0." + Chr(10) + Chr(10)
        dialog.message += "Catalog data from HackerTube and open-index/hacker-news, licensed under ODC-By 1.0."
        dialog.buttons = ["Close"]
        dialog.observeField("buttonSelected", FuncName(OnAboutSelected))
        dialog.observeField("wasClosed", FuncName(OnDialogClosed))
        m.aboutDialog = dialog
        m.top.getScene().dialog = dialog
    end if
end function

function OnAboutSelected() as void
    m.aboutDialog.close = true
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if not press
        return false
    end if
    if m.pickerMode <> ""
        if key = "back"
            ClosePicker()
            return true
        else if key = "up" or key = "down"
            if key = "up" and m.pickerIndex > 0
                m.pickerIndex -= 1
            else if key = "down" and m.pickerIndex < m.pickerEntries.Count() - 1
                m.pickerIndex += 1
            end if
            RenderPicker()
            return true
        else if key = "OK"
            OnPickerSelected()
            return true
        end if
        return true
    end if
    if m.toolbar.hasFocus()
        if key = "left" or key = "right"
            if key = "left"
                m.toolIndex = (m.toolIndex + 3) mod 4
            else
                m.toolIndex = (m.toolIndex + 1) mod 4
            end if
            FocusToolbar()
            return true
        else if key = "down"
            FocusGrid()
            return true
        else if key = "OK"
            ActivateTool()
            return true
        end if
    else if m.grid.hasFocus()
        if key = "up" or key = "down" or key = "left" or key = "right"
            MoveGrid(key)
            return true
        else if key = "back"
            m.advanceAfterLoad = false
            FocusToolbar()
            return true
        else if key = "OK"
            OnVideoSelected()
            return true
        end if
    end if
    if key = "options"
        OpenSearch()
        return true
    end if
    return false
end function
